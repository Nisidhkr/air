{
  "title": "Fylo Platform",
  "uid": "fylo-platform",
  "tags": ["fylo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "type": "gauge", "title": "Active transfers",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "fylo_transfer_active_total", "refId": "A" }] },
    { "id": 2, "type": "timeseries", "title": "Transfer bytes/sec",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "rate(fylo_transfer_bytes_total[1m])", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] } },
    { "id": 3, "type": "stat", "title": "Transfer error rate (5m)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "rate(fylo_transfer_errors_total[5m])", "refId": "A" }] },
    { "id": 4, "type": "timeseries", "title": "P99 transfer duration",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.99, rate(fylo_transfer_duration_seconds_bucket[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },

    { "id": 5, "type": "timeseries", "title": "HTTP requests/sec by route",
      "gridPos": { "h": 6, "w": 10, "x": 0, "y": 6 },
      "targets": [{ "expr": "sum by (route) (rate(fylo_http_requests_total[1m]))",
                    "legendFormat": "{{route}}", "refId": "A" }] },
    { "id": 6, "type": "stat", "title": "HTTP 4xx/5xx per sec",
      "gridPos": { "h": 6, "w": 7, "x": 10, "y": 6 },
      "targets": [{ "expr": "sum(rate(fylo_http_requests_total{status=~\"4..|5..\"}[1m]))", "refId": "A" }] },
    { "id": 7, "type": "gauge", "title": "Active WebSocket connections",
      "gridPos": { "h": 6, "w": 7, "x": 17, "y": 6 },
      "targets": [{ "expr": "fylo_websocket_connections_active", "refId": "A" }] },

    { "id": 8, "type": "timeseries", "title": "JVM heap used",
      "gridPos": { "h": 6, "w": 10, "x": 0, "y": 12 },
      "targets": [
        { "expr": "fylo_jvm_heap_used_bytes", "legendFormat": "used", "refId": "A" },
        { "expr": "fylo_jvm_heap_max_bytes", "legendFormat": "max", "refId": "B" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] } },
    { "id": 9, "type": "gauge", "title": "Available processors",
      "gridPos": { "h": 6, "w": 7, "x": 10, "y": 12 },
      "targets": [{ "expr": "fylo_jvm_available_processors", "refId": "A" }] },
    { "id": 10, "type": "stat", "title": "Storage used",
      "gridPos": { "h": 6, "w": 7, "x": 17, "y": 12 },
      "targets": [{ "expr": "fylo_storage_used_bytes", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] } }
  ]
}
